# Local tool output and scratch: every dot-directory at the root except the
# ones the repository tracks
/.*/
!/.github/

# DRY_RUN artifacts from scripts/publish.sh and scripts/daily-review.sh
/animap.json
/animap.json.*
/actions.json
/review.json

# animap explain -json output from a local run
/explain.json

# Local Go workspace overrides
go.work
go.work.sum
